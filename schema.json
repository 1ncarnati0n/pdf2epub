{
  "type": "object",
  "additionalProperties": false,
  "required": ["continues", "notation", "blocks"],
  "properties": {
    "continues": { "type": "boolean", "description": "첫 블록이 직전 페이지 마지막 문단의 연속이면 true" },
    "notation": { "type": "string", "description": "이 페이지에서 새로 정의된 기호/표기 규칙. 없으면 빈 문자열" },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text", "level", "ordered", "bbox"],
        "properties": {
          "type": { "type": "string", "enum": ["heading", "paragraph", "math", "figure", "table", "list", "contents"] },
          "text": { "type": "string" },
          "level": { "type": "integer", "description": "heading 레벨 1~3, 그 외 0" },
          "ordered": { "type": "boolean", "description": "list 가 번호 목록이면 true" },
          "bbox": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": "number" },
            "description": "[x, y, w, h], 페이지 좌상단 기준 0~1 정규화"
          }
        }
      }
    }
  }
}
